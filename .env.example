# Shared by every lab. This file stays in the labs directory.
# Copy it to .env in the same directory and fill the empty values.
# Do not commit .env. Do not put a real PAT or OpenAI key in this example.

# Konnect region: us, eu, or au. kongctl uses us when this is unset.
KONGCTL_DEFAULT_KONNECT_REGION=us

# Personal access token for kongctl. This is not the API key the client sends.
KONGCTL_DEFAULT_KONNECT_PAT=

# AI Gateway the Data Plane is connected to. The YAML looks up this id.
AI_GATEWAY_ID=
AI_GATEWAY_NAME=

# Optional labels. The steps do not read them.
KONNECT_ORG_NAME=
KONNECT_ORG_ID=

# Data Plane proxy on this machine.
PROXY=http://127.0.0.1:8000
WSS=ws://127.0.0.1:8000

# Raw OpenAI key, without a Bearer prefix. The YAML adds "Bearer " in the vault.
OPENAI_API_KEY=

# API key the client sends in the apikey header. Stored on consumer credential sts-test-app-lab-key.
# Distinct from the OpenAI key and the Konnect token.
STS_TEST_APP_KEY=
