# Shared by every lab. This file stays in the labs directory.
# Copy it to .env in the same directory and fill the empty values.
# Do not commit .env. Do not put a real PAT or OpenAI key in this example.

# Konnect region: us, eu, or au. kongctl uses us when this is unset.
KONGCTL_DEFAULT_KONNECT_REGION=us

# Personal access token for kongctl. This is not the API key the client sends.
KONGCTL_DEFAULT_KONNECT_PAT=

# AI Gateway the Data Plane is connected to. The YAML looks up this id.
AI_GATEWAY_ID=
AI_GATEWAY_NAME=

# Optional labels. The steps do not read them.
KONNECT_ORG_NAME=
KONNECT_ORG_ID=

# Data Plane proxy on this machine.
PROXY=http://127.0.0.1:8000
WSS=ws://127.0.0.1:8000

# Raw OpenAI key, without a Bearer prefix. The YAML adds "Bearer " in the vault.
OPENAI_API_KEY=

# API key the client sends in the apikey header. Stored on consumer credential sts-test-app-lab-key.
# Distinct from the OpenAI key and the Konnect token.
STS_TEST_APP_KEY=

# Lab 02 client keys, one per tier. Each is the apikey header for that consumer.
# Distinct from the OpenAI key, the Konnect token, and STS_TEST_APP_KEY.
# Generate a value with: openssl rand -hex 24
STS_LAB02_TIER1_KEY=
STS_LAB02_TIER2_KEY=
STS_LAB02_TIER3_KEY=

# Lab 03 client keys. Each is the apikey header for that consumer.
# Distinct from the OpenAI key, the Konnect token, and the Lab 1 and Lab 2 keys.
# Generate a value with: openssl rand -hex 24
STS_LAB03_ALLOWED_KEY=
STS_LAB03_DENIED_KEY=

# Lab 04 client keys, one per principal. Each is the apikey header for that principal.
# Distinct from the OpenAI key, the Konnect token, and the Lab 1, Lab 2, and Lab 3 keys.
# Generate a value with: openssl rand -hex 24
STS_LAB04_TIER1_KEY=
STS_LAB04_TIER2_KEY=
STS_LAB04_TIER3_KEY=

# Hostnames the Data Plane container uses to reach Lab 03 containers
# published on 127.0.0.1. Docker Desktop provides host.docker.internal.
# Redis is published on 16379 and the PII service on 18080.
STS_LAB03_REDIS_HOST=host.docker.internal
STS_LAB03_PII_HOST=host.docker.internal
